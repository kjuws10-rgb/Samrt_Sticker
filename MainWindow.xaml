<Window x:Class="SmartSticker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Smart Sticker" Height="230" Width="480" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FF20242A">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Smart Sticker" Foreground="White" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="화면을 캡처하고, 이미지가 포함된 메모로 바로 보관하세요." Foreground="#FFC9CDD4" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Click="NewNote_Click" Content="＋ 새 메모" FontWeight="SemiBold"/><Button Click="Capture_Click" Content="▣ 화면 캡처" FontWeight="SemiBold" Background="#FF4C8BF5" Foreground="White"/><Button Click="Settings_Click" Content="⚙ 설정"/><TextBlock Text="캡처는 전체 화면을 저장합니다." Foreground="#FFC9CDD4" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel>
  </Grid>
</Window>
