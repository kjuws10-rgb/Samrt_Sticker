<Window x:Class="SmartSticker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Smart Sticker" Height="700" Width="335" MinHeight="420" MinWidth="290" WindowStartupLocation="Manual" Left="20" Top="20" Background="Transparent" AllowsTransparency="False" WindowStyle="None" ResizeMode="CanResize" Opacity="0">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="7" CornerRadius="10" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border x:Name="Root" Background="#FFFCFCFC" CornerRadius="10" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
   <Button Grid.Column="0" Click="NewNote_Click" Content="＋" FontSize="24" FontWeight="Light" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="새 메모" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <TextBlock Grid.Column="1" Text="스티커 메모" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" Foreground="#FF24262B"/>
   <Button Grid.Column="2" Click="Settings_Click" Content="⚙" FontSize="16" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="설정" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <Button Grid.Column="3" Click="Hide_Click" Content="×" FontSize="22" FontWeight="Light" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="트레이로 숨기기" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
  </Grid>
  <Border Grid.Row="1" Background="#FFF0F1F3" CornerRadius="4" Margin="1,2,1,5"><Grid><TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" BorderThickness="0" Background="Transparent" Padding="10,4,30,4" FontSize="13" VerticalContentAlignment="Center"/><TextBlock Text="⌕" FontSize="20" Foreground="#FF85898F" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"/></Grid></Border>
  <ListBox x:Name="NotesList" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="NotesList_SelectionChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="RenderTransformOrigin" Value=".5,.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".86"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.018" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.018" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="#FFFFF6CC" CornerRadius="4" Padding="13,10" MinHeight="80"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding TimeLabel}" HorizontalAlignment="Right" Foreground="#FF78756A" FontSize="10"/><TextBlock Grid.Row="1" Text="{Binding Preview}" TextWrapping="Wrap" Foreground="#FF393A3D" FontSize="13" Margin="0,3,10,0" MaxHeight="57"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
  <TextBlock Grid.Row="3" Text="트레이 아이콘에서 언제든 메모를 관리할 수 있습니다" Foreground="#FF8B8E94" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
 </Grid></Border><Window.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></EventTrigger></Window.Triggers>
</Window>
