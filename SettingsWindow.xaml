<Window x:Class="SmartSticker.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Smart Sticker 설정" Width="470" Height="515" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="설정" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="시작 방식과 캡처 동작을 관리합니다." Foreground="#FF666666" Margin="0,5,0,16"/></StackPanel>
  <StackPanel Grid.Row="1">
   <CheckBox x:Name="AutoStart" Content="Windows 로그인 시 Smart Sticker 자동 실행" Margin="0,7" FontSize="15"/>
   <TextBlock Text="현재 사용자 계정의 시작 프로그램에 등록됩니다." Foreground="#FF777777" Margin="24,0,0,8"/>
   <CheckBox x:Name="RestoreNotes" Content="앱 실행 시 이전 메모 복원" Margin="0,7" FontSize="15"/>
   <CheckBox x:Name="DefaultPinned" Content="새 메모를 항상 위에 표시" Margin="0,7" FontSize="15"/>
   <CheckBox x:Name="CopyCapture" Content="캡처한 화면을 클립보드에도 복사" Margin="0,7" FontSize="15"/>
   <StackPanel Orientation="Horizontal" Margin="0,12,0,3"><TextBlock Text="화면 캡처 단축키" Width="145" VerticalAlignment="Center"/><TextBox x:Name="CaptureShortcut" Width="220" ToolTip="예: Shift + F5, Ctrl + Alt + S"/></StackPanel>
   <TextBlock Text="예: Shift + F5 / Ctrl + Alt + S. 다른 앱이 사용 중인 단축키는 등록할 수 없습니다." Foreground="#FF777777" Margin="145,0,0,6" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" Margin="0,7"><TextBlock Text="새 메모 기본 글꼴" Width="145" VerticalAlignment="Center"/><ComboBox x:Name="DefaultFontFamilyBox" Width="140" IsEditable="True"><ComboBoxItem Content="맑은 고딕"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="나눔고딕"/></ComboBox><TextBlock Text="크기" Margin="13,0,6,0" VerticalAlignment="Center"/><ComboBox x:Name="DefaultFontSizeBox" Width="55"><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/></ComboBox></StackPanel>
   <TextBlock Text="모든 메모 및 설정은 이 PC의 사용자 계정에만 저장됩니다." Foreground="#FF777777" TextWrapping="Wrap" Margin="0,17,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="Cancel_Click" Content="취소"/><Button Click="Save_Click" Content="저장" Background="#FF4C8BF5" Foreground="White"/></StackPanel>
 </Grid>
</Window>
