<Window x:Class="SmartSticker.NoteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Smart Sticker 메모" Width="360" Height="440" MinWidth="260" MinHeight="240" WindowStartupLocation="Manual" Background="Transparent" AllowsTransparency="True" WindowStyle="None">
 <Border x:Name="Root" Background="#FFFFF6C9" CornerRadius="10" BorderBrush="#18000000" BorderThickness="1" SnapsToDevicePixels="True">
  <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Background="#26FFFFFF" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" HorizontalAlignment="Left" Click="NewNote_Click" Content="＋" FontSize="25" FontWeight="Light" Padding="12,0" ToolTip="새 메모" Background="Transparent" BorderThickness="0"/>
    <Button Grid.Column="1" Click="More_Click" Content="•••" FontSize="17" Padding="11,0" ToolTip="색상 변경 또는 메모 삭제" Background="Transparent" BorderThickness="0"/>
    <Button Grid.Column="2" Click="Close_Click" Content="×" FontSize="27" FontWeight="Light" Padding="11,0" ToolTip="메모 닫기" Background="Transparent" BorderThickness="0"/>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,9"><StackPanel>
    <Border x:Name="ImageCard" Background="#22FFFFFF" CornerRadius="6" Visibility="Collapsed"><Image x:Name="Preview" Stretch="Uniform" MaxHeight="210" Margin="4"><Image.ContextMenu><ContextMenu><MenuItem Header="다른 이름으로 이미지 저장..." Click="SaveImage_Click"/></ContextMenu></Image.ContextMenu></Image></Border>
    <RichTextBox x:Name="Editor" BorderThickness="0" Background="Transparent" FontSize="16" AcceptsReturn="True" TextChanged="Editor_TextChanged" MinHeight="150" Padding="0,10,0,4"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="#18000000" BorderThickness="0,1,0,0" Background="#20FFFFFF"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0">
    <Button Click="Bold_Click" Content="B" FontWeight="Bold" FontSize="16" Padding="8,2" ToolTip="굵게" Background="Transparent" BorderThickness="0"/>
    <Button Click="Italic_Click" Content="I" FontStyle="Italic" FontSize="16" Padding="8,2" ToolTip="기울임꼴" Background="Transparent" BorderThickness="0"/>
    <Button Click="Underline_Click" FontSize="16" Padding="8,2" ToolTip="밑줄" Background="Transparent" BorderThickness="0"><TextBlock Text="U" TextDecorations="Underline"/></Button>
    <Button Click="Strike_Click" FontSize="16" Padding="8,2" ToolTip="취소선" Background="Transparent" BorderThickness="0"><TextBlock Text="ab" TextDecorations="Strikethrough"/></Button>
    <Button Click="Bullets_Click" Content="☷" FontSize="18" Padding="8,2" ToolTip="글머리 기호" Background="Transparent" BorderThickness="0"/>
    <Button Click="Capture_Click" Content="▧" FontSize="19" Padding="9,2" ToolTip="이 메모에 화면 캡처 첨부" Background="Transparent" BorderThickness="0"/>
   </StackPanel></Border>
  </Grid>
 </Border>
</Window>
