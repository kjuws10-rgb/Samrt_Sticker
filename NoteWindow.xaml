<Window x:Class="SmartSticker.NoteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Smart Sticker 메모" Width="360" Height="440" MinWidth="260" MinHeight="240" WindowStartupLocation="Manual" Background="Transparent" AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResize">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" CornerRadius="10" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border x:Name="Root" Background="#FFFFF6C9" CornerRadius="10" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
  <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Background="#26FFFFFF" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" HorizontalAlignment="Left" Click="NewNote_Click" Content="＋" FontSize="25" FontWeight="Light" Padding="12,0" ToolTip="새 메모" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <TextBlock x:Name="ReminderCountdown" Grid.Column="0" Margin="55,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#FF6B6654" Visibility="Collapsed"/>
    <Button Grid.Column="1" Click="More_Click" Content="•••" FontSize="17" Padding="11,0" ToolTip="색상 변경 또는 메모 삭제" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button Grid.Column="2" Click="Close_Click" Content="×" FontSize="27" FontWeight="Light" Padding="11,0" ToolTip="메모 닫기" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   </Grid>
   <Grid x:Name="ContentGrid" Grid.Row="1" Margin="14,9"><Grid.RowDefinitions><RowDefinition x:Name="ImageRow" Height="0"/><RowDefinition x:Name="ImageSplitterRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="ImageCard" Grid.Row="0" Background="#22FFFFFF" CornerRadius="6" Visibility="Collapsed" ClipToBounds="True" MinHeight="60"><ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"><Image x:Name="Preview" Stretch="Uniform" Width="{Binding ActualWidth, ElementName=ImageScroll}" Height="{Binding ActualHeight, ElementName=ImageScroll}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" MouseWheel="Preview_MouseWheel" MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseLeftButtonUp"><Image.RenderTransform><TransformGroup><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/></TransformGroup></Image.RenderTransform><Image.ContextMenu><ContextMenu><MenuItem Header="이미지 복사" Click="CopyImage_Click"/><MenuItem Header="다른 이름으로 이미지 저장..." Click="SaveImage_Click"/><Separator/><MenuItem Header="메모에서 이미지 삭제" Click="DeleteImage_Click"/></ContextMenu></Image.ContextMenu></Image></ScrollViewer></Border>
    <GridSplitter x:Name="ImageSplitter" Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" DragCompleted="ImageSplitter_DragCompleted"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"><Border Height="2" Width="42" CornerRadius="1" Background="#42000000" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ControlTemplate></GridSplitter.Template></GridSplitter>
    <RichTextBox x:Name="Editor" Grid.Row="2" BorderThickness="0" Background="Transparent" FontSize="16" AcceptsReturn="True" TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown" MinHeight="80" Padding="0,10,0,4" VerticalScrollBarVisibility="Auto"/>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#18000000" BorderThickness="0,1,0,0" Background="#20FFFFFF"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0">
    <Button Click="Bold_Click" Content="B" FontWeight="Bold" FontSize="16" Padding="8,2" ToolTip="굵게" Background="Transparent" BorderThickness="0"/>
    <Button Click="Italic_Click" Content="I" FontStyle="Italic" FontSize="16" Padding="8,2" ToolTip="기울임꼴" Background="Transparent" BorderThickness="0"/>
    <Button Click="Underline_Click" FontSize="16" Padding="8,2" ToolTip="밑줄" Background="Transparent" BorderThickness="0"><TextBlock Text="U" TextDecorations="Underline"/></Button>
    <Button Click="Strike_Click" FontSize="16" Padding="8,2" ToolTip="취소선" Background="Transparent" BorderThickness="0"><TextBlock Text="ab" TextDecorations="Strikethrough"/></Button>
    <Button Click="Bullets_Click" Content="☷" FontSize="18" Padding="8,2" ToolTip="글머리 기호" Background="Transparent" BorderThickness="0"/>
    <Button Click="Capture_Click" Content="▧" FontSize="19" Padding="9,2" ToolTip="이 메모에 화면 캡처 첨부" Background="Transparent" BorderThickness="0"/>
    <Button Click="Opacity_Click" Content="◐" FontSize="17" Padding="8,2" ToolTip="메모 투명도" Background="Transparent" BorderThickness="0"/>
    <Button Click="Reminder_Click" Content="⏰" FontSize="16" Padding="8,2" ToolTip="이벤트 알림 설정" Background="Transparent" BorderThickness="0"/>
   </StackPanel></Border>
  </Grid>
 </Border>
</Window>
